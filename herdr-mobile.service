[Unit]
Description=Herdr Mobile Web Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/herdr-mobile
ExecStart=/usr/bin/python3 /root/projects/herdr-mobile/server.py
Restart=always
RestartSec=3
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=HERDR_SOCKET=/root/.config/herdr/herdr.sock

[Install]
WantedBy=multi-user.target
